# ===== BLUE — Environment Configuration =====
# Copy this file to server/.env and fill in real values.
# Never commit your real .env file.

# ---- Server ----
PORT=8787
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- AI Provider (default: gemini) ----
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Web Search Tool ----
# Default provider needs NO key (DuckDuckGo HTML search, best-effort).
# For higher quality/reliable results, set SEARCH_PROVIDER=serpapi and SERPAPI_KEY.
SEARCH_PROVIDER=duckduckgo
SERPAPI_KEY=

# ---- Database ----
DATABASE_PATH=./data/blue.sqlite

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# ---- Agent safety limits ----
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=6
AGENT_STEP_TIMEOUT_MS=30000
AGENT_TOTAL_TIMEOUT_MS=120000

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
